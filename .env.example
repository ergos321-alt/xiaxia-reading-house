# Required. Leave blank here; set real values in Render Environment Variables.
DATABASE_URL=
PRIVATE_ACCESS_PASSWORD=
ACTION_API_TOKEN=
FLASK_SECRET_KEY=
SUPABASE_URL=
# Server-side only. Never expose this key in HTML, JavaScript, or OpenAPI.
SUPABASE_SERVICE_ROLE_KEY=
# This bucket must already exist and remain Private (public=false).
SUPABASE_STORAGE_BUCKET=xiaxia-reading-house-private

# Optional operational settings.
MAX_UPLOAD_MB=50
DB_POOL_MIN=1
DB_POOL_MAX=5
COOKIE_SECURE=true

# Default-off controlled experiment. It never changes /reader/<book_id>.
READER_ENGINE_POC_ENABLED=false
# Short-lived private Storage source URL; accepted range is 60-300 seconds.
READER_ENGINE_POC_SIGNED_URL_TTL=180
